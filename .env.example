# All optional. Copy to .env.local to change them locally, or set them as
# environment variables in your build/hosting service.

# Name shown in the header and footer of your copy.
# VITE_SITE_NAME=my-site.example

# Link to your copy's source code, shown in the footer.
# VITE_SOURCE_URL=https://github.com/your-name/washing

# A simple front-end password prompt. NOT security: it is readable in the built JavaScript.
# VITE_ACCESS_PASSWORD=

# Read a different network (e.g. ghostnet) or explorer.
# VITE_TZKT_API=https://api.tzkt.io/v1
# VITE_EXPLORER=https://tzkt.io

# Serve from a sub-path, e.g. GitHub Pages without a custom domain: /washing/
# BASE_PATH=/
